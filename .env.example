# mackbot secrets — copy this file to `.env` and fill in real values.
# `.env` is gitignored; never commit it or paste these into chat.
#
#   cp .env.example .env

# Executor v2 MCP endpoint for the org, with browser approvals enabled:
#   hosted:    https://mcp.executor.sh/org/<org-id-or-slug>/mcp?elicitation_mode=browser
#   self-host: <origin>/mcp?elicitation_mode=browser
EXECUTOR_URL=

# Org-scoped Executor personal access token, sent as a bearer token.
EXECUTOR_TOKEN=

# OpenCode Go API key (read from process.env by pi-ai via nodejs_compat).
OPENCODE_API_KEY=

# Bearer token required on POST /chat/:bot and GET /status. Use a long random
# value, e.g. `openssl rand -hex 32`.
CHAT_BEARER_TOKEN=
